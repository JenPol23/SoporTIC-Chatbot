    "seguimiento": "true si el turno es un seguimiento corto que debe resolverse con el caso activo",
    "aviso_privacidad": "true si el turno debe advertir que no se escriban contraseñas o datos personales",
    "final": "estado final esperado de cada caso: resuelto | escalado"
  },
